<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kullanıcı Adı"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivVerified"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="#4CAF50"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>

            <!-- YENİ: Silme Butonu -->
            <ImageView
                android:id="@+id/btnDeleteReview"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#D32F2F"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10.11.2023"
            android:textSize="12sp"
            android:textColor="#777" />

        <TextView
            android:id="@+id/tvRatings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="H:5 L:4 F:3"
            android:textColor="#555"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Yorum içeriği buraya gelecek." />

        <!-- Restoran Sahibinin Cevabı -->
        <LinearLayout
            android:id="@+id/layoutOwnerReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#FF9800"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restoran Sahibi"
                    android:textStyle="bold"
                    android:textColor="#FF9800"
                    android:textSize="12sp"/>
            </LinearLayout>
            
            <TextView
                android:id="@+id/tvOwnerReplyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cevap metni..."
                android:layout_marginTop="4dp"
                android:textColor="#555555"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>